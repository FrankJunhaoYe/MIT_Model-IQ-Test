# Actual browser origin; HTTPS, no trailing slash or page path.
PUBLIC_ORIGIN=https://test.example.com
# Existing Docker network attached to Nginx Proxy Manager.
NPM_NETWORK=nginx-proxy-manager_default
# Optional upstream restriction; * permits public HTTPS API domains.
MIT_ALLOWED_ORIGINS=*
# Limits per Node process; each selected test uses one request slot.
MIT_MAX_CONCURRENT=30
MIT_MAX_CONCURRENT_PER_IP=3
MIT_REQUESTS_PER_MINUTE=30
# Exact proxy peer IPs or CIDRs, comma separated. Empty ignores forwarded headers.
# For NPM, use its IP on NPM_NETWORK; do not trust all private networks.
MIT_TRUSTED_PROXIES=
# Do not put model API keys in this file.
